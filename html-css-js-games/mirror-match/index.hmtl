<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mirror Game (Select the Mirror)</title>
  <style>
    :root{
      --bg:#0b1220;
      --panel:#0f1b33;
      --text:#e8eefc;
      --muted:#a6b3d1;
      --accent:#6ea8ff;
      --good:#36d399;
      --bad:#fb7185;
      --shadow: 0 12px 30px rgba(0,0,0,.35);
      --radius:18px;
    }

    *{box-sizing:border-box;}
    body{
      margin:0;
      font-family:system-ui,-apple-system,Segoe UI,Roboto,Ubuntu,Cantarell,Noto Sans,Arial,sans-serif;
      background: radial-gradient(1200px 800px at 70% -10%, rgba(110,168,255,.28), transparent 60%),
                  radial-gradient(900px 600px at 0% 10%, rgba(54,211,153,.18), transparent 55%),
                  var(--bg);
      color:var(--text);
      min-height:100svh;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:24px;
    }

    .app{
      width:min(980px, 100%);
      display:grid;
      grid-template-columns: 1.15fr .85fr;
      gap:18px;
    }

    @media (max-width: 900px){
      .app{grid-template-columns:1fr;}
    }

    .panel{
      background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.02));
      border:1px solid rgba(255,255,255,.10);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow:hidden;
    }

    header{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      padding:18px 18px 12px;
      gap:12px;
    }

    .title{display:flex; flex-direction:column; gap:6px;}
    .title h1{font-size:18px; margin:0; letter-spacing:.3px;}
    .title p{margin:0; color:var(--muted); font-size:13px; line-height:1.35;}

    .controls{display:flex; gap:10px; align-items:center; flex-wrap:wrap; justify-content:flex-end;}

    button, select{
      border-radius:12px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(15,27,51,.7);
      color:var(--text);
      padding:10px 12px;
      cursor:pointer;
      outline:none;
      transition:.15s transform ease, .15s background ease, .15s border ease;
      font-weight:700;
      font-size:13px;
    }

    button:hover, select:hover{ border-color: rgba(110,168,255,.45); }
    button:active{ transform: translateY(1px); }

    .primary{
      background: linear-gradient(180deg, rgba(110,168,255,.9), rgba(110,168,255,.55));
      border-color: rgba(110,168,255,.65);
      color:#081126;
    }

    .ghost{ background: rgba(15,27,51,.45); }

    .row{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      align-items:center;
      justify-content:space-between;
      padding: 0 18px 14px;
      border-top:1px solid rgba(255,255,255,.08);
      border-bottom:1px solid rgba(255,255,255,.08);
      background: rgba(11,22,48,.45);
    }

    .stats{display:flex; gap:14px; flex-wrap:wrap; align-items:center; color:var(--muted); font-size:13px;}

    .pill{
      padding:8px 10px;
      border:1px solid rgba(255,255,255,.10);
      border-radius:999px;
      background: rgba(17,28,53,.55);
      display:flex;
      gap:8px;
      align-items:center;
    }

    .dot{width:8px; height:8px; border-radius:999px; background: var(--accent); box-shadow: 0 0 0 3px rgba(110,168,255,.20);}    

    .content{padding:18px; display:flex; flex-direction:column; gap:16px;}

    .prompt{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      padding:14px;
      border-radius:16px;
      border:1px solid rgba(255,255,255,.10);
      background: rgba(17,28,53,.45);
    }

    .prompt b{color:var(--text);}
    .prompt small{color:var(--muted); display:block; margin-top:2px;}

    .badge{
      padding:6px 10px;
      border-radius:999px;
      font-weight:900;
      font-size:12px;
      letter-spacing:.3px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(15,27,51,.55);
      white-space:nowrap;
    }
    .badge.good{ border-color: rgba(54,211,153,.45); color: var(--good); }
    .badge.bad{ border-color: rgba(251,113,133,.45); color: var(--bad); }

    .targetWrap{
      display:grid;
      grid-template-columns: 1fr;
      gap:12px;
    }

    .targetCard{
      border-radius:18px;
      border:1px solid rgba(255,255,255,.10);
      background: radial-gradient(240px 160px at 30% 30%, rgba(110,168,255,.14), transparent 55%),
                  linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
      box-shadow: 0 10px 18px rgba(0,0,0,.25);
      padding:18px;
      display:flex;
      align-items:center;
      justify-content:center;
      min-height:200px;
      position:relative;
      overflow:hidden;
    }

    .targetLabel{
      position:absolute;
      left:14px;
      top:14px;
      font-size:12px;
      color: rgba(232,238,252,.85);
      background: rgba(15,27,51,.55);
      border: 1px solid rgba(255,255,255,.10);
      padding:6px 10px;
      border-radius:999px;
      display:flex;
      gap:8px;
      align-items:center;
    }

    .options{
      display:grid;
      grid-template-columns: repeat(4, 1fr);
      gap:12px;
    }

    @media (max-width: 700px){
      .options{grid-template-columns: repeat(2, 1fr);}      
    }

    .optBtn{
      border-radius:16px;
      border:1px solid rgba(255,255,255,.10);
      background: radial-gradient(220px 140px at 30% 30%, rgba(54,211,153,.10), transparent 55%),
                  linear-gradient(180deg, rgba(255,255,255,.05), rgba(255,255,255,.02));
      box-shadow: 0 10px 18px rgba(0,0,0,.22);
      padding:12px;
      display:flex;
      flex-direction:column;
      gap:10px;
      align-items:center;
      justify-content:center;
      min-height:170px;
      text-align:center;
    }

    .optBtn:hover{ transform: translateY(-2px); border-color: rgba(110,168,255,.35); }

    .optTag{
      font-size:12px;
      color: rgba(232,238,252,.85);
      border:1px solid rgba(255,255,255,.10);
      background: rgba(15,27,51,.55);
      border-radius:999px;
      padding:6px 10px;
      width:max-content;
    }

    .optBtn.correct{ border-color: rgba(54,211,153,.60); box-shadow: 0 10px 24px rgba(54,211,153,.14); }
    .optBtn.wrong{ border-color: rgba(251,113,133,.60); box-shadow: 0 10px 24px rgba(251,113,133,.12); }

    .side{padding:18px; display:flex; flex-direction:column; gap:14px;}

    .box{
      background: rgba(11,22,48,.35);
      border:1px solid rgba(255,255,255,.10);
      border-radius: 16px;
      padding:14px;
    }

    .box h2{margin:0 0 6px; font-size:14px;}
    .box p, .box li{margin:0; color:var(--muted); font-size:13px; line-height:1.35;}
    ul{ margin:10px 0 0; padding-left:18px; }

    .kbd{
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
      font-size: 12px;
      border:1px solid rgba(255,255,255,.12);
      background: rgba(15,27,51,.55);
      padding:2px 6px;
      border-radius: 8px;
      color: rgba(232,238,252,.9);
    }

    /* SVG look */
    svg{ width: 140px; height: 140px; }
    .stroke{ stroke: rgba(232,238,252,.92); stroke-width: 10; stroke-linecap: round; stroke-linejoin: round; fill: none; }
  </style>
</head>
<body>
  <div class="app">

    <!-- MAIN GAME PANEL -->
    <section class="panel" aria-label="Mirror Game">
      <header>
        <div class="title">
          <h1>Mirror Game</h1>
          <p>At the top you see the <b>original figure</b>. Below, select the correct mirror: <b>Diagonal</b>, <b>Horizontal</b> or <b>Vertical</b>.</p>
        </div>
        <div class="controls">
          <label>
            <select id="rounds" aria-label="Rounds">
              <option value="10" selected>10 rounds</option>
              <option value="15">15 rounds</option>
              <option value="20">20 rounds</option>
            </select>
          </label>
          <button class="ghost" id="skipBtn" type="button">Skip</button>
          <button class="primary" id="newBtn" type="button">New</button>
        </div>
      </header>

      <div class="row">
        <div class="stats">
          <div class="pill"><span class="dot"></span> Round: <b id="round">1</b>/<b id="roundMax">10</b></div>
          <div class="pill">Score: <b id="score">0</b></div>
          <div class="pill">Streak: <b id="streak">0</b></div>
          <div class="pill">Time: <b id="time">0:00</b></div>
        </div>
        <div class="stats">
          <div class="pill">Keys: <span class="kbd">1</span> <span class="kbd">2</span> <span class="kbd">3</span> <span class="kbd">4</span></div>
        </div>
      </div>

      <div class="content">
        <div class="prompt">
          <div>
            <div style="font-weight:900; font-size:14px;">Select: <span id="taskLabel">Diagonal mirror</span></div>
            <small>Choose the option that matches the required mirror transformation of the original.</small>
          </div>
          <span class="badge" id="badge">Playing</span>
        </div>

        <!-- TOP ORIGINAL FIGURE -->
        <div class="targetWrap">
          <div class="targetCard" id="targetCard">
            <div class="targetLabel">Original</div>
            <div id="target"></div>
          </div>
        </div>

        <!-- OPTIONS BELOW -->
        <div class="options" id="options"></div>
      </div>
    </section>

    <!-- SIDE PANEL -->
    <aside class="panel" aria-label="Instructions">
      <div class="side">
        <div class="box">
          <h2>Mirror types</h2>
          <ul>
            <li><b>Horizontal</b>: flip left ↔ right</li>
            <li><b>Vertical</b>: flip top ↔ bottom</li>
            <li><b>Diagonal</b>: flip both (like turning the paper around)</li>
          </ul>
        </div>

        <div class="box">
          <h2>How to play</h2>
          <ul>
            <li>Look at the figure on top.</li>
            <li>Read the task (Diagonal/Horizontal/Vertical).</li>
            <li>Pick the correct option below.</li>
            <li>Correct = +1 score, wrong = streak reset.</li>
          </ul>
        </div>

        <div class="box">
          <h2>Tips</h2>
          <p>Some shapes are tricky. Focus on <b>small details</b> like a notch, arrow head, or cut corner.</p>
        </div>
      </div>
    </aside>

  </div>

  <script>
    // Mirror Game (selection-based)
    // Top: original figure
    // Bottom: 4 options -> Original (decoy) + Horizontal + Vertical + Diagonal
    // Task: pick the requested mirror type

    const roundsEl = document.getElementById('rounds');
    const newBtn = document.getElementById('newBtn');
    const skipBtn = document.getElementById('skipBtn');

    const roundEl = document.getElementById('round');
    const roundMaxEl = document.getElementById('roundMax');
    const scoreEl = document.getElementById('score');
    const streakEl = document.getElementById('streak');
    const timeEl = document.getElementById('time');
    const badgeEl = document.getElementById('badge');
    const taskLabelEl = document.getElementById('taskLabel');

    const targetEl = document.getElementById('target');
    const optionsEl = document.getElementById('options');

    // Simple SVG shapes with an asymmetric detail so mirrors are visible.
    const SHAPES = [
      // Wrench – asymmetric jaw
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M20 60 L52 28" />
          <path class="stroke" d="M52 28 L66 42" />
          <path class="stroke" d="M66 42 L60 48" />
          <circle cx="22" cy="62" r="4" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Lightning bolt with offset cut
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M48 10 L28 54 H48 L34 90 L72 42 H52" />
          <circle cx="60" cy="36" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Camera – lens off-center
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <rect x="20" y="34" width="60" height="36" rx="6" class="stroke" />
          <circle cx="56" cy="52" r="10" class="stroke" />
          <circle cx="32" cy="40" r="4" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Flag on pole (flag only one side)
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M28 18 V82" />
          <path class="stroke" d="M28 20 H66 L58 36 L66 52 H28" />
          <circle cx="28" cy="18" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Spiral – asymmetric curl
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M50 20 C70 20 78 36 70 50 C62 64 40 64 40 48 C40 34 58 34 58 46" />
          <circle cx="58" cy="46" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,

      // Gear – deliberately asymmetric (extra tooth only on one side)
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="50" cy="50" r="26" class="stroke" />
          <circle cx="50" cy="50" r="9" class="stroke" />
          <!-- main teeth -->
          <path class="stroke" d="M50 8 V20" />
          <path class="stroke" d="M80 50 H92" />
          <path class="stroke" d="M50 80 V92" />
          <path class="stroke" d="M8 50 H20" />
          <!-- asymmetric tooth -->
          <path class="stroke" d="M66 16 L58 26" />
          <!-- notch -->
          <circle cx="60" cy="64" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Circuit – asymmetric branch + offset node
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M18 22 H56 V46 H82" />
          <path class="stroke" d="M56 46 V70" />
          <circle cx="18" cy="22" r="5" fill="rgba(232,238,252,.92)" />
          <circle cx="56" cy="70" r="4" fill="rgba(232,238,252,.92)" />
          <circle cx="82" cy="46" r="6" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Key – asymmetric teeth lengths
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <circle cx="30" cy="42" r="14" class="stroke" />
          <circle cx="30" cy="42" r="4" fill="rgba(232,238,252,.92)" />
          <path class="stroke" d="M44 42 H78 V50 H70 V60 H58" />
          <!-- extra short tooth only on bottom -->
          <path class="stroke" d="M58 60 H52" />
        </svg>
      `,
      // Shield – emblem shifted off center
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M22 22 L50 14 L78 22 V54 C78 68 60 82 50 88 C40 82 22 68 22 54 Z" />
          <!-- off-center emblem -->
          <path class="stroke" d="M56 32 V66" />
          <circle cx="46" cy="38" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Bird – asymmetric wing + eye
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M18 62 C42 22 72 26 82 44" />
          <path class="stroke" d="M18 62 L54 50 L40 78" />
          <circle cx="74" cy="40" r="4" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Anchor – offset fluke
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M50 10 V64" />
          <path class="stroke" d="M26 58 C30 72 40 80 50 80" />
          <path class="stroke" d="M74 58 C70 72 58 78 52 78" />
          <circle cx="50" cy="20" r="6" class="stroke" />
          <circle cx="44" cy="76" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Paperclip – uneven loop
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M36 26 C22 26 22 44 36 44 H64 C78 44 78 64 64 64 H42" />
          <circle cx="60" cy="60" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,
      // Rocket – fin only one side
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M50 14 C66 28 66 60 50 86 C34 60 34 28 50 14 Z" />
          <path class="stroke" d="M50 56 L64 64" />
          <circle cx="50" cy="38" r="6" class="stroke" />
        </svg>
      `,
      // Puzzle piece – missing tab
      () => `
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <path class="stroke" d="M24 24 H44 C44 18 56 18 56 24 H76 V44 C82 44 82 56 76 56 V76 H56 C56 82 44 82 44 76 H24 Z" />
          <circle cx="64" cy="64" r="3" fill="rgba(232,238,252,.92)" />
        </svg>
      `,

    ];

    const MIRROR_TYPES = [
      { key: 'diagonal', label: 'Diagonal mirror', transform: 'scale(-1,-1)' },
      { key: 'horizontal', label: 'Horizontal mirror', transform: 'scale(-1,1)' },
      { key: 'vertical', label: 'Vertical mirror', transform: 'scale(1,-1)' },
    ];

    let state = {
      round: 1,
      roundMax: 10,
      score: 0,
      streak: 0,
      lock: false,
      task: null,
      shapeHtml: '',
      timer: null,
      seconds: 0,
    };

    function shuffle(arr){
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    function formatTime(sec){
      const m = Math.floor(sec / 60);
      const s = sec % 60;
      return `${m}:${String(s).padStart(2,'0')}`;
    }

    function setBadge(text, type){
      badgeEl.textContent = text;
      badgeEl.className = 'badge' + (type ? ` ${type}` : '');
    }

    function startTimer(){
      if (state.timer) return;
      state.timer = setInterval(() => {
        state.seconds++;
        timeEl.textContent = formatTime(state.seconds);
      }, 1000);
    }

    function stopTimer(){
      clearInterval(state.timer);
      state.timer = null;
    }

    function applyTransform(container, cssTransform){
      // Wrap SVG in a transform box so we can mirror reliably
      container.style.display = 'grid';
      container.style.placeItems = 'center';

      const wrap = container.querySelector('.twrap');
      if (wrap) {
        wrap.style.transform = cssTransform;
      }
    }

    function renderTarget(){
      targetEl.innerHTML = `<div class="twrap" style="transform-origin:center;">${state.shapeHtml}</div>`;
      applyTransform(targetEl, 'scale(1,1)');
    }

    function makeOption(typeKey, label, transform, index){
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'optBtn';
      btn.dataset.key = typeKey;
      btn.innerHTML = `
        <div class="optTag">${label} (${index})</div>
        <div class="optSvg"><div class="twrap" style="transform-origin:center; display:grid; place-items:center;">${state.shapeHtml}</div></div>
      `;

      // Apply transform to the inner wrap
      const twrap = btn.querySelector('.twrap');
      twrap.style.transform = transform;

      btn.addEventListener('click', () => choose(typeKey, btn));
      return btn;
    }

    function renderOptions(){
      optionsEl.innerHTML = '';

      // Build 4 options: Original (decoy) + 3 mirror types
      const opts = [
        { key: 'original', label: 'Original', transform: 'scale(1,1)' },
        ...MIRROR_TYPES
      ];

      const shuffled = shuffle(opts);

      shuffled.forEach((o, idx) => {
        const btn = makeOption(o.key, o.label, o.transform, idx+1);
        optionsEl.appendChild(btn);
      });
    }

    function nextRound(){
      state.lock = false;
      setBadge('Playing');

      // Pick shape + task
      state.shapeHtml = SHAPES[Math.floor(Math.random() * SHAPES.length)]();
      state.task = MIRROR_TYPES[Math.floor(Math.random() * MIRROR_TYPES.length)];

      taskLabelEl.textContent = state.task.label;
      roundEl.textContent = String(state.round);
      roundMaxEl.textContent = String(state.roundMax);
      scoreEl.textContent = String(state.score);
      streakEl.textContent = String(state.streak);

      renderTarget();
      renderOptions();

      startTimer();
    }

    function endGame(){
      stopTimer();
      state.lock = true;
      setBadge('Completed', 'good');
      taskLabelEl.textContent = 'Game finished';
      // disable all
      [...optionsEl.querySelectorAll('button')].forEach(b => b.disabled = true);
    }

    function choose(key, btn){
      if (state.lock) return;
      state.lock = true;

      const correctKey = state.task.key;
      const all = [...optionsEl.querySelectorAll('.optBtn')];

      // mark selection
      if (key === correctKey) {
        btn.classList.add('correct');
        state.score++;
        state.streak++;
        setBadge('Correct', 'good');
      } else {
        btn.classList.add('wrong');
        state.streak = 0;
        setBadge('Wrong', 'bad');
      }

      // highlight correct answer
      const correctBtn = all.find(b => b.dataset.key === correctKey);
      if (correctBtn) correctBtn.classList.add('correct');

      scoreEl.textContent = String(state.score);
      streakEl.textContent = String(state.streak);

      // proceed
      setTimeout(() => {
        state.round++;
        if (state.round > state.roundMax) {
          endGame();
        } else {
          nextRound();
        }
      }, 850);
    }

    function newGame(){
      state.roundMax = parseInt(roundsEl.value, 10) || 10;
      state.round = 1;
      state.score = 0;
      state.streak = 0;
      state.seconds = 0;
      timeEl.textContent = '0:00';
      setBadge('Playing');
      stopTimer();
      nextRound();
    }

    function skip(){
      if (state.lock) return;
      state.round++;
      if (state.round > state.roundMax) {
        endGame();
      } else {
        nextRound();
      }
    }

    // Keyboard shortcuts: 1-4 choose an option
    window.addEventListener('keydown', (e) => {
      const k = e.key;
      if (k >= '1' && k <= '4') {
        const idx = Number(k) - 1;
        const btn = optionsEl.querySelectorAll('.optBtn')[idx];
        if (btn) btn.click();
      }
      if (k.toLowerCase() === 'r') newGame();
      if (k.toLowerCase() === 's') skip();
    });

    newBtn.addEventListener('click', newGame);
    skipBtn.addEventListener('click', skip);
    roundsEl.addEventListener('change', newGame);

    newGame();
  </script>
</body>
</html>
