{
   "$schema": "http://json-schema.org/draft-07/schema#",
   "title": "Play50 Rodin assets specification",
   "type": "object",
   "additionalProperties": false,
   "required": ["slug", "universe", "seed", "assets"],
   "properties": {
      "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "universe": { "type": "string", "minLength": 1 },
      "seed": { "type": "integer", "minimum": 0, "maximum": 65535 },
      "assets": {
         "type": "array", "minItems": 1,
         "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "kind", "mode", "prompt", "attempts", "target", "budget", "textureSize"],
            "properties": {
               "id": { "type": "string", "pattern": "^[a-zA-Z0-9]+(?:-[a-zA-Z0-9]+)*$" },
               "kind": { "enum": ["character", "prop"] },
               "mode": { "enum": ["image", "text"] },
               "prompt": { "type": "string", "minLength": 1, "maxLength": 1024 },
               "concept": { "type": "string", "pattern": "^tools/hyper3d/concepts/[a-zA-Z0-9_-]+\\.png$" },
               "tier": { "enum": ["Gen-2.5-Extreme-Low", "Gen-2.5-Low", "Gen-2.5-Medium", "Gen-2.5-High"] },
               "qualityOverride": { "type": "integer", "minimum": 500, "maximum": 20000 },
               "attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
               "target": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
               "budget": {
                  "type": "object", "additionalProperties": false, "required": ["tris", "bytes"],
                  "properties": {
                     "tris": { "type": "integer", "minimum": 1, "maximum": 20000 },
                     "bytes": { "type": "integer", "minimum": 1, "maximum": 1500000 }
                  }
               },
               "textureSize": { "type": "integer", "minimum": 1, "maximum": 1024 }
            },
            "allOf": [
               {
                  "if": { "properties": { "kind": { "const": "character" } } },
                  "then": { "required": ["concept"], "properties": { "mode": { "const": "image" } } },
                  "else": {
                     "properties": {
                        "mode": { "const": "text" },
                        "textureSize": { "maximum": 512 },
                        "budget": { "properties": { "tris": { "maximum": 5000 }, "bytes": { "maximum": 300000 } } }
                     }
                  }
               }
            ]
         }
      }
   }
}
